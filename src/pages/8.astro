---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="page">
    <div class="page-header">
      <h1 class="page-title">8. Cifrado de Imágenes con DES</h1>
    </div>

    <section class="card statement-card">
      <h2 class="card-title">Enunciado</h2>
      <p>
        Utilizar una implementación del algoritmo DES en cualquier lenguaje de
        programación (en la página puse un enlace a una implementación en
        Python), en el que se haga lo siguiente:
      </p>
      <ul class="styled-list">
        <li>Recibir como entrada cualquier imagen en cualquier formato</li>
        <li>
          Convertir la imagen a una representación de bits, por lo que
          simplemente convierta el archivo que lee en un arreglo de bits
        </li>
        <li>Cifrar la imagen utilizando DES y una clave determinada por usted</li>
        <li>
          Codificar el mensaje cifrado en Base64 (en la página del curso hay un
          enlace a una implementación de Base64 en Python)
        </li>
        <li>Mostrar en la consola el texto en Base 64</li>
        <li>Decodificar de Base64 a la representación en bits</li>
        <li>Descifrar utilizando DES</li>
        <li>Generar la imagen original y mostrarla</li>
      </ul>
      <p>Subir un archivo ZIP con lo siguiente:</p>
      <ul class="styled-list">
        <li>Script en donde se implementó todo</li>
        <li>Imagen de prueba</li>
        <li>Screenshot o video en donde se muestre todo el funcionamiento</li>
      </ul>
    </section>

    <div class="solutions-grid">
      <section class="card solution-card">
        <h2 class="card-title">
          <span class="card-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
            </svg>
          </span>
          Cifrar
        </h2>

        <div class="input-group">
          <label for="selector-imagen">Imagen de entrada</label>
          <input
            type="file"
            id="selector-imagen"
            class="input file-input"
            accept="image/*"
          />
        </div>

        <div class="input-group">
          <label for="clave-cifrar">Clave secreta (DES usa 8 caracteres)</label>
          <input
            type="text"
            id="clave-cifrar"
            class="input"
            value="MiClav12"
            maxlength="8"
            placeholder="Clave de cifrado"
          />
        </div>

        <button id="btn-encriptar" class="btn btn-primary" disabled>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
          </svg>
          Encriptar imagen
        </button>

        <div id="resultado-cifrado" class="result-group hidden">
          <div class="result-item">
            <span class="result-label">Texto cifrado resultante (Base64):</span>
            <textarea
              id="texto-cifrado"
              class="input code-textarea"
              readonly
            ></textarea>
          </div>
          <button id="btn-descargar" class="btn btn-secondary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Descargar archivo (.des)
          </button>
        </div>
      </section>

      <section class="card solution-card">
        <h2 class="card-title">
          <span class="card-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
            </svg>
          </span>
          Descifrar
        </h2>

        <div class="input-group">
          <label for="texto-a-descifrar">Texto cifrado (Base64)</label>
          <textarea
            id="texto-a-descifrar"
            class="input code-textarea"
            rows="4"
            placeholder="Usa el resultado de la izquierda o pega aquí el contenido de un archivo .des"
          ></textarea>
        </div>

        <div class="input-group">
          <label for="clave-descifrar">Introduce la misma clave</label>
          <input
            type="text"
            id="clave-descifrar"
            class="input"
            value="MiClav12"
            maxlength="8"
            placeholder="Clave de descifrado"
          />
        </div>

        <button id="btn-descifrar" class="btn btn-primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
          </svg>
          Descifrar imagen
        </button>

        <div id="resultado-descifrado" class="result-group hidden">
          <div class="result-item">
            <span class="result-label">Imagen recuperada con éxito:</span>
            <img
              id="imagen-recuperada"
              class="image-preview"
              alt="Imagen resultante del descifrado"
            />
          </div>
        </div>
      </section>
    </div>
  </main>

  <script>
    import CryptoJS from "crypto-js";

    const selector =
      document.querySelector<HTMLInputElement>("#selector-imagen");
    const claveCifrarInput =
      document.querySelector<HTMLInputElement>("#clave-cifrar");
    const btnEncriptar =
      document.querySelector<HTMLButtonElement>("#btn-encriptar");
    const resultadoCifradoDiv =
      document.querySelector<HTMLDivElement>("#resultado-cifrado");
    const textoCifradoTxt =
      document.querySelector<HTMLTextAreaElement>("#texto-cifrado");
    const btnDescargar =
      document.querySelector<HTMLButtonElement>("#btn-descargar");

    const textoADescifrarTxt =
      document.querySelector<HTMLTextAreaElement>("#texto-a-descifrar");
    const claveDescifrarInput =
      document.querySelector<HTMLInputElement>("#clave-descifrar");
    const btnDescifrar =
      document.querySelector<HTMLButtonElement>("#btn-descifrar");
    const resultadoDescifradoDiv =
      document.querySelector<HTMLDivElement>("#resultado-descifrado");
    const imagenRecuperada =
      document.querySelector<HTMLImageElement>("#imagen-recuperada");

    let imagenBase64Pura: string = "";

    selector?.addEventListener("change", (e: Event) => {
      const target = e.target as HTMLInputElement;
      const archivo = target.files?.[0];

      if (archivo) {
        const lector = new FileReader();
        lector.onload = (evento: ProgressEvent<FileReader>) => {
          const resultadoLectura = evento.target?.result as string;
          const partes = resultadoLectura.split(",");
          if (partes.length === 2) {
            imagenBase64Pura = partes[1];
            if (btnEncriptar) btnEncriptar.disabled = false;
          }
        };
        lector.readAsDataURL(archivo);
      }
    });

    btnEncriptar?.addEventListener("click", () => {
      const clave = claveCifrarInput?.value || "";
      if (!clave) return alert("Por favor introduce una clave de cifrado.");

      const cifrado = CryptoJS.DES.encrypt(imagenBase64Pura, clave);
      const resultadoString = cifrado.toString();

      if (textoCifradoTxt && resultadoCifradoDiv && textoADescifrarTxt) {
        textoCifradoTxt.value = resultadoString;
        textoADescifrarTxt.value = resultadoString;
        resultadoCifradoDiv.classList.remove("hidden");
      }

      if (btnDescargar) {
        btnDescargar.onclick = () => {
          const blob = new Blob([resultadoString], { type: "text/plain" });
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = "imagen_encriptada.des";
          a.click();
          URL.revokeObjectURL(url);
        };
      }
    });

    btnDescifrar?.addEventListener("click", () => {
      const textoCifrado = textoADescifrarTxt?.value || "";
      const clave = claveDescifrarInput?.value || "";

      if (!textoCifrado || !clave) {
        return alert(
          "Asegúrate de ingresar el texto cifrado y la clave correcta.",
        );
      }

      try {
        const bytesDescifrados = CryptoJS.DES.decrypt(textoCifrado, clave);
        const base64Recuperado = bytesDescifrados.toString(CryptoJS.enc.Utf8);

        if (!base64Recuperado) {
          throw new Error("Clave incorrecta o datos corruptos.");
        }

        if (imagenRecuperada && resultadoDescifradoDiv) {
          imagenRecuperada.src = `data:image/png;base64,${base64Recuperado}`;
          resultadoDescifradoDiv.classList.remove("hidden");
          resultadoDescifradoDiv.scrollIntoView({ behavior: "smooth" });
        }
      } catch (error) {
        alert(
          "Error al descifrar. Verifica que la clave sea exacta y los datos no estén corruptos.",
        );
        console.error(error);
      }
    });
  </script>

  <style>
    .page {
      max-width: 960px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }

    .page-header {
      margin-bottom: 2rem;
    }

    .page-title {
      font-size: 2.25rem;
      font-weight: 800;
      margin: 0 0 0.35rem;
      letter-spacing: -0.02em;
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 1.75rem;
      margin-bottom: 1.5rem;
      transition: border-color 0.2s ease;
    }

    .card:hover {
      border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
    }

    .card-title {
      font-size: 1.2rem;
      font-weight: 700;
      margin: 0 0 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .card-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 0.5rem;
      background: var(--accent-glow);
      color: var(--accent);
    }

    .card p {
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0.5rem 0;
      font-size: 1rem;
    }

    .styled-list {
      list-style: none;
      padding-left: 1.25rem;
      margin: 0.5rem 0;
    }

    .styled-list li {
      position: relative;
      color: var(--text-secondary);
      line-height: 1.6;
      padding-left: 0.75rem;
      font-size: 1rem;
    }

    .styled-list li::before {
      content: "";
      position: absolute;
      left: -0.25rem;
      top: 0.6rem;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
    }

    .solutions-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 1.5rem;
    }

    .input-group {
      margin-bottom: 1rem;
    }

    .input-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-secondary);
      margin-bottom: 0.4rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .input {
      width: 100%;
      padding: 0.7rem 0.9rem;
      border-radius: 0.5rem;
      border: 1px solid var(--border);
      background: var(--input-bg);
      color: var(--text-primary);
      font-size: 0.95rem;
      font-family: inherit;
      line-height: 1.5;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
      box-sizing: border-box;
    }

    .input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .input::placeholder {
      color: var(--text-secondary);
      opacity: 0.6;
    }

    .file-input {
      padding: 0.5rem;
      cursor: pointer;
    }

    .file-input::file-selector-button {
      margin-right: 0.75rem;
      padding: 0.45rem 0.9rem;
      border: none;
      border-radius: 0.375rem;
      background: var(--accent);
      color: white;
      font-family: inherit;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .file-input::file-selector-button:hover {
      background: var(--accent-hover);
    }

    .code-textarea {
      min-height: 6rem;
      resize: vertical;
      font-family: "Courier New", Courier, monospace;
      font-size: 0.95rem;
      word-break: break-all;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.65rem 1.5rem;
      border: none;
      border-radius: 0.5rem;
      font-size: 0.9rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: var(--accent);
      color: white;
      box-shadow: 0 2px 8px var(--accent-glow);
    }

    .btn-primary:hover {
      background: var(--accent-hover);
      transform: translateY(-1px);
      box-shadow: 0 4px 16px var(--accent-glow);
    }

    .btn-primary:active {
      transform: translateY(0);
    }

    .btn-primary:disabled {
      background: var(--text-secondary);
      opacity: 0.5;
      cursor: not-allowed;
      box-shadow: none;
      transform: none;
    }

    .btn-secondary {
      background: transparent;
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .result-group {
      margin-top: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
    }

    .result-item {
      margin-bottom: 0.75rem;
    }

    .result-item:last-child {
      margin-bottom: 0;
    }

    .result-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 0.4rem;
    }

    .result-group .btn {
      margin-top: 0.5rem;
    }

    .image-preview {
      display: block;
      max-width: 100%;
      margin-top: 0.5rem;
      border-radius: 0.5rem;
      border: 1px solid var(--border);
    }

    .hidden {
      display: none;
    }

    @media (max-width: 720px) {
      .solutions-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
