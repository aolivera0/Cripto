---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="page">
    <div class="page-header">
      <h1 class="page-title">2. Taller Playfair</h1>
    </div>

    <section class="card statement-card">
      <h2 class="card-title">Enunciado</h2>
      <p>
        Implementar el algoritmo de cifrado de bloques Playfair Cipher en
        Python. Utilizar un parámetro para identificar si es para cifrar o
        descifrar, por ejemplo, 1 o 0.
      </p>
      <p>El algoritmo debe recibir como entrada para cifrar:</p>
      <ul class="styled-list">
        <li>El mensaje en texto claro</li>
        <li>La clave</li>
      </ul>
      <p>Para descifrar:</p>
      <ul class="styled-list">
        <li>Mensaje cifrado</li>
        <li>La calve</li>
      </ul>
      <p>Cargar en esta tarea un archivo ZIP con lo siguiente:</p>
      <ul class="styled-list">
        <li>Archivo Python</li>
        <li>
          Pequeño video o captura de pantalla en donde se mostrará funcionar el
          algoritmo
        </li>
      </ul>
    </section>

    <div class="solutions-grid">
      <section class="card solution-card">
        <h2 class="card-title">
          <span class="card-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </span>
          Encriptar
        </h2>

        <div class="input-group">
          <label for="llave-a-usar">LLave a usar</label>
          <input
            type="text"
            id="llave-a-usar"
            class="input"
            value="YOAN PINZON"
            placeholder="Escribe tu mensaje..."
          />
        </div>

        <button id="generar-llave" class="btn btn-primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          Generar llave
        </button>

        <div class="result-group">
            <span class="result-label">Llave:</span>
          <div class="result-item">
            <textarea
              id="llave-matriz"
              class="result-value textarea"
              cols="9"
              rows="5"
              disabled>-</textarea
            >
          </div>
          <div class="input-group">
            <label for="texto-a-cifrar">Texto a cifrar</label>
            <input
              type="text"
              id="texto-a-cifrar"
              class="input"
              placeholder="Escribe tu mensaje..."
            />
          </div>

          <button id="cifrar-btn" class="btn btn-primary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            Cifrar
          </button>

          <div class="result-group">
            <div class="result-item">
              <span class="result-label">Mensaje cifrado:</span>
              <p id="texto-cifrado" class="result-value">-</p>
            </div>
          </div>
        </div>
      </section>

      <section class="card solution-card">
        <h2 class="card-title">
          <span class="card-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
            </svg>
          </span>
          Desencriptar
        </h2>

        <div class="input-group">
          <label for="texto-a-descifrar">Texto a descifrar</label>
          <input
            type="text"
            id="texto-a-descifrar"
            class="input"
            placeholder="Texto cifrado..."
          />
        </div>

        <div class="input-group">
          <label for="llave-a-descifrar">Llave</label>
          <input
            type="text"
            id="llave-a-descifrar"
            class="input"
            placeholder="Llave de descifrado..."
          />
        </div>

        <button id="descifrar-btn" class="btn btn-primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
          </svg>
          Descifrar
        </button>

        <div class="result-group">
          <div class="result-item">
            <span class="result-label">Mensaje descifrado:</span>
            <p id="texto-descifrado" class="result-value">-</p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script>
    const llaveAUsar =
      document.querySelector<HTMLInputElement>("#llave-a-usar")!;
    const llaveMatriz =
      document.querySelector<HTMLTextAreaElement>("#llave-matriz")!;
    const btnGenerarLlave =
      document.querySelector<HTMLButtonElement>("#generar-llave")!;
    const textoACifrar =
      document.querySelector<HTMLInputElement>("#texto-a-cifrar")!;
    const cifrarBtn = document.querySelector<HTMLButtonElement>("#cifrar-btn")!;
    const textoCifradoCampo =
      document.querySelector<HTMLParagraphElement>("#texto-cifrado")!;

    function showResult(el: HTMLElement, text: string) {
      el instanceof HTMLTextAreaElement
        ? (el.value = text || "-")
        : (el.textContent = text || "-");
    }

    const ALFABETO = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let matrizLlave: String[][] = [];
    let textoCifrado = "";

    function generarMatriz(input: string) {
      let textoLimpio = input.toUpperCase().replaceAll(/\s+/g, "");
      let cadenaCompleta = textoLimpio + ALFABETO;
      let IJInsertado = false;
      let elementosUnicos:String[] = [];

      for (const caracter of cadenaCompleta) {
        if (caracter === "I" || caracter === "J") {
          if (!IJInsertado) {
            elementosUnicos.push("IJ");
            IJInsertado = true;
          }
        } else {
          if (!elementosUnicos.includes(caracter))
            elementosUnicos.push(caracter);
        }
      }

      for (let i = 0; i < 25; i += 5) {
        matrizLlave.push(elementosUnicos.slice(i, i + 5));
      }

      return matrizLlave;
    }

    document.addEventListener("DOMContentLoaded", () => {
      const matriz = generarMatriz(llaveAUsar.value);
      showResult(llaveMatriz, matriz.flat().join(" "));
    });

    btnGenerarLlave.addEventListener("click", () => {
      const input = llaveAUsar.value;
      if (!input) return;

      matrizLlave = [];
      const matriz = generarMatriz(input);

      showResult(llaveMatriz, matriz.flat().join(" "));
    });

    cifrarBtn?.addEventListener("click", () => {
      let input = textoACifrar.value.toUpperCase().replaceAll(/\s+/g, "");
      const ultimaLetra = input.slice(-1);
      if (input.length % 2 !== 0) input += ultimaLetra;
      let inputModificado = input.replaceAll("J", "I");
      textoCifrado = "";

      for (let i = 0; i < inputModificado.length; i += 2) {
        cifrarDosEnDos(inputModificado[i], inputModificado[i + 1]);
      }

      showResult(textoCifradoCampo, textoCifrado);
    });

    function cifrarDosEnDos(a: String, b: String) {
      let posFilaA: number = -1;
      let posColumnaA: number = -1;
      let posFilaB: number = -1;
      let posColumnaB: number = -1;

      let matrizLlaveModificada: String[][] = matrizLlave.map((fila) =>
        fila.map((letra) => (letra === "IJ" ? "I" : letra)),
      );

      for (let i = 0; i < matrizLlaveModificada.length; i++) {
        for (let j = 0; j < matrizLlaveModificada.length; j++) {
          if (matrizLlaveModificada[i][j] === a) {
            posFilaA = i;
            posColumnaA = j;
          }
          if (matrizLlaveModificada[i][j] === b) {
            posFilaB = i;
            posColumnaB = j;
          }
        }
      }

      if (posColumnaB === posColumnaA) {
        textoCifrado += matrizLlaveModificada[(posFilaA + 1) % 5][posColumnaA];
        textoCifrado += matrizLlaveModificada[(posFilaB + 1) % 5][posColumnaB];
      } else if (posFilaA === posFilaB) {
        textoCifrado += matrizLlaveModificada[posFilaA][(posColumnaA + 1) % 5];
        textoCifrado += matrizLlaveModificada[posFilaB][(posColumnaB + 1) % 5];
      } else {
        textoCifrado += matrizLlaveModificada[posFilaA][posColumnaB];
        textoCifrado += matrizLlaveModificada[posFilaB][posColumnaA];
      }

      return textoCifrado;
    }
  </script>
</Layout>

<style>
  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 0.35rem;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.75rem;
    margin-bottom: 1.5rem;
    transition: border-color 0.2s ease;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
    background: var(--accent-glow);
    color: var(--accent);
  }

  .card p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0.5rem 0;
  }

  .textarea {
    resize: none;
  }

  .styled-list {
    list-style: none;
    padding-left: 1.25rem;
    margin: 0.5rem 0;
  }

  .styled-list li {
    position: relative;
    color: var(--text-secondary);
    line-height: 1.6;
    padding-left: 0.75rem;
  }

  .styled-list li::before {
    content: "";
    position: absolute;
    left: -0.25rem;
    top: 0.6rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .input-group {
    margin-bottom: 1rem;
  }

  .input-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .input {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--input-bg);
    color: var(--text-primary);
    font-size: 0.95rem;
    font-family: inherit;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
    box-sizing: border-box;
  }

  .input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .input::placeholder {
    color: var(--text-secondary);
    opacity: 0.6;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.5rem;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: white;
    box-shadow: 0 2px 8px var(--accent-glow);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px var(--accent-glow);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .result-group {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .result-item {
    margin-bottom: 0.75rem;
  }

  .result-item:last-child {
    margin-bottom: 0;
  }

  .result-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .result-value {
    font-size: 1rem;
    font-family: "Courier New", Courier, monospace;
    word-break: break-all;
    margin: 0.25rem 0 0;
    padding: 0.5rem 0.75rem;
    background: var(--input-bg);
    border-radius: 0.375rem;
    border: 1px solid var(--border);
    color: var(--text-primary);
    min-height: 1.5rem;
  }

  .key-value {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .solutions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
