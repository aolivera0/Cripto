---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="page">
    <div class="page-header">
      <h1 class="page-title">4. Algoritmo de Vigenère</h1>
    </div>

    <section class="card statement-card">
      <h2 class="card-title">Enunciado</h2>
      <p>
        Implementar el algoritmo de Vigenère en el lenguaje Python teniendo en
        cuenta lo siguiente:
      </p>
      <p>Ciframiento</p>
      <ul class="styled-list">
        <li>
          Desde la consola debe recibir la clave, el parámetro t y el mensaje a
          cifrar
        </li>
        <li>Como resultado debe generar el texto cifrado</li>
      </ul>
      <p>Deciframiento</p>
      <ul class="styled-list">
        <li>
          Desde la consola debe recibir la clave, el parámetro t y el texto
          cifrado
        </li>
        <li>Como resultado debe generar el mensaje en texto claro</li>
      </ul>
      <p>Qué debo subir?</p>
      <ul class="styled-list">
        <li>
          Capture un screenshot de la ejecución de ciframiento y deciframiento
        </li>
        <li>
          Construya un ZIP con el código .py y el la imagen del screenshot
        </li>
      </ul>
    </section>

    <div class="solutions-grid">
      <section class="card solution-card">
        <h2 class="card-title">
          <span class="card-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
            </svg>
          </span>
          Cifrar
        </h2>

        <div class="input-group">
          <label for="texto-a-cifrar">Texto a cifrar</label>
          <input
            type="text"
            id="texto-a-cifrar"
            class="input"
            placeholder="Texto a cifrar..."
          />
        </div>

        <div class="input-group">
          <label for="palabra-clave-cifrar">Palabra clave</label>
          <input
            type="text"
            id="palabra-clave-cifrar"
            class="input"
            placeholder="Palabra clave..."
          />
        </div>

        <div class="input-group">
          <label for="parametro-t-cifrar">Parámetro t</label>
          <input
            type="number"
            value="5"
            min="1"
            id="parametro-t-cifrar"
            class="input"
            placeholder="Parámetro t..."
          />
        </div>

        <button id="cifrar-btn" class="btn btn-primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
          </svg>
          Cifrar
        </button>

        <div class="result-group">
          <div class="result-item">
            <span class="result-label">Mensaje cifrado:</span>
            <p id="texto-cifrado" class="result-value">-</p>
          </div>
        </div>
      </section>
      <section class="card solution-card">
        <h2 class="card-title">
          <span class="card-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
            </svg>
          </span>
          Descifrar
        </h2>

        <div class="input-group">
          <label for="texto-a-descifrar">Texto a descifrar</label>
          <input
            type="text"
            id="texto-a-descifrar"
            class="input"
            placeholder="Texto a cifrar..."
          />
        </div>

        <div class="input-group">
          <label for="palabra-clave-descifrar">Palabra clave</label>
          <input
            type="text"
            id="palabra-clave-descifrar"
            class="input"
            placeholder="Palabra clave..."
          />
        </div>

        <div class="input-group">
          <label for="parametro-t-descifrar">Parámetro t</label>
          <input
            type="number"
            value="5"
            min="1"
            id="parametro-t-descifrar"
            class="input"
            placeholder="Parámetro t..."
          />
        </div>

        <button id="descifrar-btn" class="btn btn-primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
          </svg>
          Descifrar
        </button>

        <div class="result-group">
          <div class="result-item">
            <span class="result-label">Mensaje descifrado:</span>
            <p id="texto-descifrado" class="result-value">-</p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script>
    const textoACifrar =
      document.querySelector<HTMLInputElement>("#texto-a-cifrar")!;
    const palabraClaveCifrar = document.querySelector<HTMLInputElement>(
      "#palabra-clave-cifrar",
    )!;
    const btnCifrar = document.querySelector<HTMLButtonElement>("#cifrar-btn")!;
    const textoCifrado =
      document.querySelector<HTMLParagraphElement>("#texto-cifrado")!;
    const parametroTCifrar = document.querySelector<HTMLInputElement>(
      "#parametro-t-cifrar",
    )!;
    const textoADescifrar =
      document.querySelector<HTMLInputElement>("#texto-a-descifrar")!;
    const palabraClaveDescifrar = document.querySelector<HTMLInputElement>(
      "#palabra-clave-descifrar",
    )!;
    const parametroTDescifrar = document.querySelector<HTMLInputElement>(
      "#parametro-t-descifrar",
    )!;
    const btnDescifrar =
      document.querySelector<HTMLButtonElement>("#descifrar-btn")!;
    const textoDescifrado =
      document.querySelector<HTMLParagraphElement>("#texto-descifrado")!;

    const ALFABETO = "ABCDEFGHIJKLMNÑOPQRSTUVWXYZ";

    btnCifrar.addEventListener("click", () => {
      const mensaje = limpiarEntrada(textoACifrar);
      let palabraClave = limpiarEntrada(palabraClaveCifrar);
      let mensajeEncriptado: string = "";

      if (mensaje.length < palabraClave.length) {
        mensajeEncriptado =
          "La palabra clave debe tener menor longitud que el mensaje!";
        return;
      }

      palabraClave = obtenerPalabraClave(mensaje, palabraClave);

      for (let i = 0; i < mensaje.length; i++) {
        let indiceEnPalabraClave = ALFABETO.indexOf(palabraClave[i]);
        let indiceEnMensaje = ALFABETO.indexOf(mensaje[i]);

        mensajeEncriptado +=
          ALFABETO[(indiceEnMensaje + indiceEnPalabraClave) % ALFABETO.length];
      }

      imprimirResultado(mensajeEncriptado, parametroTCifrar, textoCifrado);
    });

    btnDescifrar.addEventListener("click", () => {
      const mensaje = limpiarEntrada(textoADescifrar);
      let palabraClave = limpiarEntrada(palabraClaveDescifrar);
      let mensajeDesencriptado: string = "";

      if (mensaje.length < palabraClave.length) {
        mensajeDesencriptado =
          "La palabra clave debe tener menor longitud que el mensaje!";
        return;
      }

      palabraClave = obtenerPalabraClave(mensaje, palabraClave);

      for (let i = 0; i < mensaje.length; i++) {
        let indiceEnPalabraClave = ALFABETO.indexOf(palabraClave[i]);
        let indiceEnMensaje = ALFABETO.indexOf(mensaje[i]);

        mensajeDesencriptado +=
          ALFABETO[
            (indiceEnMensaje - indiceEnPalabraClave < 0
              ? indiceEnMensaje - indiceEnPalabraClave + ALFABETO.length
              : indiceEnMensaje - indiceEnPalabraClave) % ALFABETO.length
          ];
      }

      imprimirResultado(mensajeDesencriptado, parametroTDescifrar, textoDescifrado,
      );
    });

    function dividirString(str: string, n: number) {
      const regex = new RegExp(`.{1,${n}}`, "g");
      return str.match(regex)?.join(" ");
    }

    function limpiarEntrada(texto: HTMLInputElement) {
      return texto.value.toUpperCase().split(" ").join("");
    }

    function obtenerPalabraClave(mensaje: string, palabraClave: string) {
      let factor = Math.ceil(mensaje.length / palabraClave.length);
      return palabraClave.repeat(factor).slice(0, mensaje.length);
    }

    function imprimirResultado(
      mensaje: string,
      T: HTMLInputElement,
      elemento: HTMLParagraphElement,
    ) {
      elemento.textContent =
        dividirString(mensaje, Number.parseInt(T.value)) ?? "";
    }
  </script>

  <style>
    .page {
      max-width: 960px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }

    .page-header {
      margin-bottom: 2rem;
    }

    .page-title {
      font-size: 2.25rem;
      font-weight: 800;
      margin: 0 0 0.35rem;
      letter-spacing: -0.02em;
    }

    .page-subtitle {
      font-size: 1rem;
      color: var(--text-secondary);
      margin: 0;
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 1.75rem;
      margin-bottom: 1.5rem;
      transition: border-color 0.2s ease;
    }

    .card:hover {
      border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
    }

    .card-title {
      font-size: 1.2rem;
      font-weight: 700;
      margin: 0 0 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .card-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 0.5rem;
      background: var(--accent-glow);
      color: var(--accent);
    }

    .card p {
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0.5rem 0;
    }

    .textarea {
      resize: none;
    }

    .styled-list {
      list-style: none;
      padding-left: 1.25rem;
      margin: 0.5rem 0;
    }

    .styled-list li {
      position: relative;
      color: var(--text-secondary);
      line-height: 1.6;
      padding-left: 0.75rem;
    }

    .styled-list li::before {
      content: "";
      position: absolute;
      left: -0.25rem;
      top: 0.6rem;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
    }

    .solutions-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 1.5rem;
    }

    .input-group {
      margin-bottom: 1rem;
    }

    .input-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-secondary);
      margin-bottom: 0.4rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .input {
      width: 100%;
      padding: 0.7rem 0.9rem;
      border-radius: 0.5rem;
      border: 1px solid var(--border);
      background: var(--input-bg);
      color: var(--text-primary);
      font-size: 0.95rem;
      font-family: inherit;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
      box-sizing: border-box;
    }

    .input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .input::placeholder {
      color: var(--text-secondary);
      opacity: 0.6;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.65rem 1.5rem;
      border: none;
      border-radius: 0.5rem;
      font-size: 0.9rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: var(--accent);
      color: white;
      box-shadow: 0 2px 8px var(--accent-glow);
    }

    .btn-primary:hover {
      background: var(--accent-hover);
      transform: translateY(-1px);
      box-shadow: 0 4px 16px var(--accent-glow);
    }

    .btn-primary:active {
      transform: translateY(0);
    }

    .result-group {
      margin-top: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
    }

    .result-item {
      margin-bottom: 0.75rem;
    }

    .result-item:last-child {
      margin-bottom: 0;
    }

    .result-label {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .result-value {
      font-size: 1rem;
      font-family: "Courier New", Courier, monospace;
      word-break: break-all;
      margin: 0.25rem 0 0;
      padding: 0.5rem 0.75rem;
      background: var(--input-bg);
      border-radius: 0.375rem;
      border: 1px solid var(--border);
      color: var(--text-primary);
      min-height: 1.5rem;
    }

    .key-value {
      color: var(--accent);
    }

    .warning-message {
      font-size: 11px;
      opacity: 60%;
    }

    @media (max-width: 720px) {
      .solutions-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
