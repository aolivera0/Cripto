---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="page">
    <div class="page-header">
      <h1 class="page-title">1. Taller OTP</h1>
      <p class="page-subtitle">One Time Pad - Cifrado de un solo uso</p>
    </div>

    <section class="card statement-card">
      <h2 class="card-title">Enunciado</h2>
      <p>Implementar el algoritmo One Time Pad (OTP) en Python.</p>
      <p>El algoritmo debe recibir como entrada para cifrar:</p>
      <ul class="styled-list">
        <li>El mensaje en texto claro</li>
        <li>La llave</li>
      </ul>
      <p>Para descifrar:</p>
      <ul class="styled-list">
        <li>Mensaje a descifrar</li>
        <li>La llave</li>
      </ul>
      <p>Cargar en esta tarea un archivo ZIP con lo siguiente:</p>
      <ul class="styled-list">
        <li>Archivo Python</li>
        <li>
          Pequeño video o captura de pantalla en donde se mostrará
          funcionar el algoritmo
        </li>
      </ul>
    </section>

    <div class="solutions-grid">
      <section class="card solution-card">
        <h2 class="card-title">
          <span class="card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </span>
          Encriptar
        </h2>

        <div class="input-group">
          <label for="texto-a-cifrar">Texto a cifrar</label>
          <input type="text" id="texto-a-cifrar" class="input" placeholder="Escribe tu mensaje..." />
        </div>

        <button id="cifrar-btn" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          Cifrar
        </button>

        <div class="result-group">
          <div class="result-item">
            <span class="result-label">Texto cifrado:</span>
            <p id="texto-cifrado" class="result-value">-</p>
          </div>
          <div class="result-item">
            <span class="result-label">Llave:</span>
            <p id="llave" class="result-value key-value">-</p>
          </div>
        </div>
      </section>

      <section class="card solution-card">
        <h2 class="card-title">
          <span class="card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
            </svg>
          </span>
          Desencriptar
        </h2>

        <div class="input-group">
          <label for="texto-a-descifrar">Texto a descifrar</label>
          <input type="text" id="texto-a-descifrar" class="input" placeholder="Texto cifrado..." />
        </div>

        <div class="input-group">
          <label for="llave-a-descifrar">Llave</label>
          <input type="text" id="llave-a-descifrar" class="input" placeholder="Llave de descifrado..." />
        </div>

        <button id="descifrar-btn" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
          </svg>
          Descifrar
        </button>

        <div class="result-group">
          <div class="result-item">
            <span class="result-label">Mensaje descifrado:</span>
            <p id="texto-descifrado" class="result-value">-</p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script>
    const textoACifrar =
      document.querySelector<HTMLInputElement>("#texto-a-cifrar")!;
    const textoCifrado =
      document.querySelector<HTMLParagraphElement>("#texto-cifrado")!;
    const textoADescifrar =
      document.querySelector<HTMLInputElement>("#texto-a-descifrar")!;
    const textoDescifrado =
      document.querySelector<HTMLParagraphElement>("#texto-descifrado")!;
    const llave = document.querySelector<HTMLParagraphElement>("#llave")!;
    const llaveADescifrar =
      document.querySelector<HTMLInputElement>("#llave-a-descifrar")!;
    const cifrarBtn = document.querySelector<HTMLButtonElement>("#cifrar-btn")!;
    const descifrarBtn =
      document.querySelector<HTMLButtonElement>("#descifrar-btn")!;

    const ALFABETO = "ABCDEFGHIJKLMNÑOPQRSTUVWXYZabcdefghijklmnñopqrstuvwxyz ";
    const BASE = ALFABETO.length;

    function showResult(el: HTMLElement, text: string) {
      el.textContent = text || "-";
    }

    cifrarBtn.addEventListener("click", () => {
      const input = textoACifrar.value;
      if (!input) return;

      let cifrado = "";
      let llaveStr = "";

      for (const caracter of input) {
        const idTexto = ALFABETO.indexOf(caracter);
        const idRadom = Math.floor(Math.random() * BASE);

        cifrado += ALFABETO[(idTexto + idRadom) % BASE];
        llaveStr += ALFABETO[idRadom];
      }

      showResult(textoCifrado, cifrado);
      showResult(llave, llaveStr);
    });

    descifrarBtn.addEventListener("click", () => {
      const texto = textoADescifrar.value;
      const llaveInput = llaveADescifrar.value;
      if (!texto || !llaveInput) return;

      let descifrado = "";
      for (let i = 0; i < texto.length; i++) {
        const idTexto = ALFABETO.indexOf(texto.at(i)!);
        const idLlave = ALFABETO.indexOf(llaveInput.at(i)!);

        descifrado +=
          ALFABETO[
            (idTexto - idLlave < 0
              ? idTexto - idLlave + BASE
              : idTexto - idLlave) % BASE
          ];
      }

      showResult(textoDescifrado, descifrado);
    });
  </script>
</Layout>

<style>
  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 0.35rem;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.75rem;
    margin-bottom: 1.5rem;
    transition: border-color 0.2s ease;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
    background: var(--accent-glow);
    color: var(--accent);
  }

  .card p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0.5rem 0;
  }

  .styled-list {
    list-style: none;
    padding-left: 1.25rem;
    margin: 0.5rem 0;
  }

  .styled-list li {
    position: relative;
    color: var(--text-secondary);
    line-height: 1.6;
    padding-left: 0.75rem;
  }

  .styled-list li::before {
    content: "";
    position: absolute;
    left: -0.25rem;
    top: 0.6rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .input-group {
    margin-bottom: 1rem;
  }

  .input-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .input {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--input-bg);
    color: var(--text-primary);
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    box-sizing: border-box;
  }

  .input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .input::placeholder {
    color: var(--text-secondary);
    opacity: 0.6;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.5rem;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: white;
    box-shadow: 0 2px 8px var(--accent-glow);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px var(--accent-glow);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .result-group {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .result-item {
    margin-bottom: 0.75rem;
  }

  .result-item:last-child {
    margin-bottom: 0;
  }

  .result-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .result-value {
    font-size: 1rem;
    font-family: 'Courier New', Courier, monospace;
    word-break: break-all;
    margin: 0.25rem 0 0;
    padding: 0.5rem 0.75rem;
    background: var(--input-bg);
    border-radius: 0.375rem;
    border: 1px solid var(--border);
    color: var(--text-primary);
    min-height: 1.5rem;
  }

  .key-value {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .solutions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
