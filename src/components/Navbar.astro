---
import ThemeToggle from './ThemeToggle.astro';
---

<nav class="navbar" aria-label="Main navigation">
	<a class="brand" href="/">
		<span class="brand-icon">&#x1F510;</span>
		Cripto
	</a>

	<ul class="nav-links">
		<li><a href="/">Inicio</a></li>
		<li class="dropdown">
			<button class="dropdown-toggle" type="button" aria-haspopup="true">
				Ejercicios <span class="arrow" aria-hidden="true">&#x25BE;</span>
			</button>
			<ul class="dropdown-menu">
				<li><a href="/1">1. Taller OTP</a></li>
				<li><a href="/2">2. Taller Playfair</a></li>
			</ul>
		</li>
		<li class="toggle-wrapper">
			<ThemeToggle />
		</li>
	</ul>
</nav>

<style>
	.navbar {
		align-items: center;
		background: var(--navbar-bg);
		display: flex;
		justify-content: space-between;
		padding: 0.875rem 2rem;
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	.brand,
	.nav-links a,
	.dropdown-toggle {
		color: var(--text-primary);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.brand {
		font-size: 1.25rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.brand-icon {
		font-size: 1.4rem;
	}

	.nav-links {
		align-items: center;
		display: flex;
		gap: 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-links > li > a,
	.dropdown-toggle {
		font-size: 0.95rem;
		font-weight: 500;
		letter-spacing: 0.01em;
	}

	.nav-links a:hover,
	.dropdown-toggle:hover {
		color: var(--accent);
	}

	.arrow {
		font-size: 0.75rem;
		margin-left: 2px;
	}

	.dropdown {
		position: relative;
	}

	.dropdown-toggle {
		background: none;
		border: 0;
		cursor: pointer;
		font: inherit;
		padding: 0;
		display: flex;
		align-items: center;
	}

	.dropdown-menu {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		box-shadow: 0 8px 24px var(--shadow);
		display: none;
		list-style: none;
		min-width: 12rem;
		padding: 0.5rem;
		position: absolute;
		right: 0;
		top: calc(100% + 0.75rem);
		z-index: 10;
	}

	.dropdown:hover .dropdown-menu,
	.dropdown:focus-within .dropdown-menu {
		display: block;
	}

	.dropdown-menu a {
		color: var(--text-primary);
		display: block;
		padding: 0.6rem 0.875rem;
		border-radius: 0.375rem;
		font-size: 0.9rem;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.dropdown-menu a:hover {
		background: var(--accent-glow);
		color: var(--accent);
	}

	.toggle-wrapper {
		margin-left: 0.5rem;
	}

	@media (max-width: 640px) {
		.navbar {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
			padding: 1rem 1.25rem;
		}

		.nav-links {
			width: 100%;
			justify-content: space-between;
		}
	}
</style>
